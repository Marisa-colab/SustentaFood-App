  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express from \'express\';\nimport path from \'path\';\nimport { fileURLToPath } from \'url\';\nimport { createServer as createViteServer } from \'vite\';\nimport { GoogleGenAI, Type } from \'@google/genai\';\nimport dotenv from \'dotenv\';\n\ndotenv.config();\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\nasync function startServer() {\n  const app = express();\n  const PORT = 3000;\n\n  app.use(express.json({ limit: \'10mb\' }));\n\n  // Shared Gemini client instance\n  const getGeminiClient = () => {\n    const apiKey = process.env.GEMINI_API_KEY;\n    if (!apiKey) {\n      console.warn(\'GEMINI_API_KEY not set. AI features will fallback gracefully.\');\n      return null;\n    }\n    return new GoogleGenAI({\n      apiKey,\n      httpOptions: {\n        headers: {\n          \'User-Agent\': \'aistudio-build\'\n        }\n      }\n    });\n  };\n\n  // Health check endpoint\n  app.get(\'/api/health\', (req, res) => {\n    res.json({ status: \'ok\', timestamp: new Date().toISOString() });\n  });\n\n  // AI Forecast & Analysis Endpoint\n  app.post(\'/api/ai/forecast\', async (req, res) => {\n    try {\n      const ai = getGeminiClient();\n      if (!ai) {\n        return res.status(503).json({\n          error: \'Chave de API Gemini n\303\243o configurada.\',\n          fallbackNotice: \'Defina a vari\303\241vel GEMINI_API_KEY no painel Secrets.\'\n        });\n      }\n\n      const { wasteLogs, stockItems, expectedDiners = 250, upcomingEmenta = \'Bacalhau com Natas e Sopa de Legumes\' } = req.body;\n\n      const prompt = `\n\303\211s o especialista s\303\251nior em Preven\303\247\303\243o de Desperd\303\255cio Alimentar e Seguran\303\247a Alimentar (HACCP) do sistema SustentaFood.\nAnalisa os dados de res\303\255duos e stocks fornecidos:\n\n- N.\302\272 de refei\303\247\303\265es previstas para amanh\303\243: ${expectedDiners}\n- Ementa planeada: \"${upcomingEmenta}\"\n- Registos de res\303\255duos recentes: ${JSON.stringify((wasteLogs || []).slice(0, 8))}\n- Items de stock cr\303\255ticos (FEFO): ${JSON.stringify((stockItems || []).slice(0, 6))}\n\nGera um relat\303\263rio de intelig\303\252ncia preditiva em Portugu\303\252s com:\n1. Alertas de Risco Preditivo (ex: excedente de sopa, pescado pr\303\263ximo de vencer)\n2. Recomenda\303\247\303\265es de Compra Inteligente\n3. Dicas de Otimiza\303\247\303\243o de Confe\303\247\303\243o e Redu\303\247\303\243o de Perdas\n4. Uma frase destacada de previs\303\243o exata para o dashboard (Exemplo: \"Para amanh\303\243 prev\303\252-se um excedente de 25 kg de sopa devido \303\240 baixa procura das \303\272ltimas 4 semanas.\")\n`;\n\n      const response = await ai.models.generateContent({\n        model: \'gemini-3.6-flash\',\n        contents: prompt,\n        config: {\n          systemInstruction: \'Responde exclusivamente em JSON estruturado com o esquema solicitado.\',\n          responseMimeType: \'application/json\',\n          responseSchema: {\n            type: Type.OBJECT,\n            properties: {\n              highlightPrediction: {\n                type: Type.STRING,\n                description: \'Previs\303\243o curta e direta para o banner do dashboard\'\n              },\n              wasteRiskScore: {\n                type: Type.NUMBER,\n                description: \'N\303\255vel de risco de desperd\303\255cio em % (0 a 100)\'\n              },\n              forecastInsights: {\n                type: Type.ARRAY,\n                items: {\n                  type: Type.OBJECT,\n                  properties: {\n                    title: { type: Type.STRING },\n                    category: { type: Type.STRING },\n                    riskLevel: { type: Type.STRING, description: \'Elevado | M\303\251dio | Baixo\' },\n                    predictedExcessKg: { type: Type.NUMBER },\n                    recommendation: { type: Type.STRING }\n                  },\n                  required: [\'title\', \'category\', \'riskLevel\', \'predictedExcessKg\', \'recommendation\']\n                }\n              },\n              procurementAdvice: {\n                type: Type.ARRAY,\n                items: {\n                  type: Type.OBJECT,\n                  properties: {\n                    item: { type: Type.STRING },\n                    action: { type: Type.STRING, description: \'Reduzir Encomenda | Aumentar | Manter | Doar Excedente\' },\n                    suggestedQtyKg: { type: Type.NUMBER },\n                    reasoning: { type: Type.STRING }\n                  },\n                  required: [\'item\', \'action\', \'suggestedQtyKg\', \'reasoning\']\n                }\n              },\n              haccpTip: {\n                type: Type.STRING,\n                description: \'Dica cr\303\255tica de seguran\303\247a alimentar e conserva\303\247\303\243o para a ementa do dia\'\n              }\n            },\n            required: [\'highlightPrediction\', \'wasteRiskScore\', \'forecastInsights\', \'procurementAdvice\', \'haccpTip\']\n          }\n        }\n      });\n\n      const parsedText = response.text || \'{}\';\n      const resultData = JSON.parse(parsedText);\n      res.json(resultData);\n    } catch (err: any) {\n      console.error(\'Erro na API AI Forecast:\', err);\n      res.status(500).json({ error: \'Erro ao gerar an\303\241lise preditiva com Gemini IA.\', details: err.message });\n    }\n  });\n\n  // AI Chat & Assistant Endpoint\n  app.post(\'/api/ai/chat\', async (req, res) => {\n    try {\n      const ai = getGeminiClient();\n      if (!ai) {\n        return res.status(503).json({\n          error: \'Chave de API Gemini n\303\243o dispon\303\255vel.\'\n        });\n      }\n\n      const { message, history = [] } = req.body;\n\n      const chat = ai.chats.create({\n        model: \'gemini-3.6-flash\',\n        config: {\n          systemInstruction: `\n\303\211s o Consultor Virtual SustentaFood, perito em Gest\303\243o de Desperd\303\255cio Alimentar, Nutri\303\247\303\243o Sustent\303\241vel, Legisla\303\247\303\243o HACCP e Economia Circular em Restaura\303\247\303\243o.\nResponde sempre em Portugu\303\252s de Portugal com tom profissional, pr\303\241tico e motivador.\nD\303\241 conselhos concretos para:\n- Reaproveitamento seguro de excedentes alimentares (conforme normas de higiene);\n- Rota\303\247\303\243o FEFO e gest\303\243o de validades;\n- Redu\303\247\303\243o de custos e emiss\303\265es de CO2;\n- Sugest\303\265es de ementas de desperd\303\255cio zero.\n`\n        }\n      });\n\n      // Send prompt\n      const response = await chat.sendMessage({ message });\n      res.json({ reply: response.text });\n    } catch (err: any) {\n      console.error(\'Erro na API AI Chat:\', err);\n      res.status(500).json({ error: \'Erro ao processar mensagem do assistente.\', details: err.message });\n    }\n  });\n\n  // Vite integration in development, static files in production\n  if (process.env.NODE_ENV !== \'production\') {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\'\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (req, res) => {\n      res.sendFile(path.join(distPath, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`Servidor SustentaFood a rodar na porta http://localhost:${PORT}`);\n  });\n}\n\nstartServer();\n"
    }
