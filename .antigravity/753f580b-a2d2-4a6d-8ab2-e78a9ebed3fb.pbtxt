  file_change {
    absolute_path_uri: "file:///src/components/EconomicAnalysisView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  TrendingDown,\n  DollarSign,\n  Scale,\n  Cloud,\n  PieChart as PieIcon,\n  Calculator,\n  ArrowRight,\n  TrendingUp,\n  Award,\n  CheckCircle2\n} from \'lucide-react\';\nimport {\n  ResponsiveContainer,\n  BarChart,\n  Bar,\n  XAxis,\n  YAxis,\n  Tooltip,\n  CartesianGrid,\n  PieChart,\n  Pie,\n  Cell,\n  Legend\n} from \'recharts\';\nimport { SummaryMetrics, WasteLog } from \'../types\';\nimport { sectorLossBreakdown } from \'../mockData\';\n\ninterface EconomicAnalysisViewProps {\n  metrics: SummaryMetrics;\n  wasteLogs: WasteLog[];\n}\n\nexport const EconomicAnalysisView: React.FC<EconomicAnalysisViewProps> = ({\n  metrics,\n  wasteLogs\n}) => {\n  // Sample Example calculation state (User can try custom numbers in live calculator)\n  const [calcKg, setCalcKg] = useState<number>(120);\n  const [calcCostPerKg, setCalcCostPerKg] = useState<number>(12.00);\n  const [calcFoodType, setCalcFoodType] = useState<string>(\'Peixe / Bacalhau\');\n\n  const customLossMonthly = calcKg * calcCostPerKg;\n  const customLossAnnual = customLossMonthly * 12;\n\n  // Category Cost Aggregation\n  const categoryCostMap: Record<string, { totalCost: number; totalKg: number }> = {};\n  wasteLogs.forEach((log) => {\n    if (!categoryCostMap[log.category]) {\n      categoryCostMap[log.category] = { totalCost: 0, totalKg: 0 };\n    }\n    categoryCostMap[log.category].totalCost += log.totalCost;\n    categoryCostMap[log.category].totalKg += log.quantity;\n  });\n\n  const categoryChartData = Object.keys(categoryCostMap).map((cat) => ({\n    name: cat,\n    cost: Number(categoryCostMap[cat].totalCost.toFixed(2)),\n    kg: Number(categoryCostMap[cat].totalKg.toFixed(1))\n  }));\n\n  const COLORS = [\'#0284c7\', \'#e11d48\', \'#16a34a\', \'#d97706\', \'#b45309\', \'#84cc16\', \'#6366f1\', \'#64748b\'];\n\n  return (\n    <div className=\"space-y-6 pb-12\">\n      {/* Title */}\n      <div className=\"bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm\">\n        <h2 className=\"text-xl font-bold text-slate-900\">An\303\241lise Econ\303\263mica & Indicadores de Desempenho (KPIs)</h2>\n        <p className=\"text-xs text-slate-500 mt-1\">\n          Monitoriza\303\247\303\243o rigorosa do custo do desperd\303\255cio, custo/refei\303\247\303\243o, proje\303\247\303\265es anuais e emiss\303\265es de carbono\n        </p>\n      </div>\n\n      {/* Main KPI Cards Row (Requirement #4) */}\n      <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-4\">\n        {/* Kg Res\303\255duos / Dia */}\n        <div className=\"bg-slate-900 text-white rounded-2xl p-5 shadow-sm border border-slate-800\">\n          <span className=\"text-[11px] font-bold text-slate-400 uppercase tracking-wider block\">M\303\251dia Di\303\241ria</span>\n          <div className=\"text-3xl font-extrabold text-white mt-1\">\n            {metrics.kgPerDayAvg.toFixed(1)} <span className=\"text-sm font-semibold text-slate-400\">kg/dia</span>\n          </div>\n          <p className=\"text-xs text-emerald-400 mt-2 font-medium flex items-center gap-1\">\n            <TrendingDown className=\"w-3.5 h-3.5\" /> -8.4% em rela\303\247\303\243o ao m\303\252s anterior\n          </p>\n        </div>\n\n        {/* Kg Res\303\255duos / Refei\303\247\303\243o Servida */}\n        <div className=\"bg-slate-900 text-white rounded-2xl p-5 shadow-sm border border-slate-800\">\n          <span className=\"text-[11px] font-bold text-slate-400 uppercase tracking-wider block\">Desperd\303\255cio / Refei\303\247\303\243o</span>\n          <div className=\"text-3xl font-extrabold text-white mt-1\">\n            {(metrics.kgPerMeal * 1000).toFixed(0)} <span className=\"text-sm font-semibold text-slate-400\">g/refei\303\247\303\243o</span>\n          </div>\n          <p className=\"text-xs text-slate-400 mt-2\">\n            Base: {metrics.mealsServedMonth.toLocaleString()} refei\303\247\303\265es servidas\n          </p>\n        </div>\n\n        {/* Custo Mensal Perdido */}\n        <div className=\"bg-rose-950/80 text-white rounded-2xl p-5 shadow-sm border border-rose-800/60\">\n          <span className=\"text-[11px] font-bold text-rose-300 uppercase tracking-wider block\">Custo Perdido (M\303\252s)</span>\n          <div className=\"text-3xl font-extrabold text-rose-300 mt-1\">\n            {metrics.totalCostLostMonth.toLocaleString(\'pt-PT\', { minimumFractionDigits: 2 })} \342\202\254\n          </div>\n          <p className=\"text-xs text-rose-200 mt-2\">\n            Proje\303\247\303\243o Anual: <strong className=\"text-white font-bold\">{(metrics.totalCostLostMonth * 12).toLocaleString(\'pt-PT\')} \342\202\254/ano</strong>\n          </p>\n        </div>\n\n        {/* Emiss\303\265es CO2e */}\n        <div className=\"bg-emerald-950/80 text-white rounded-2xl p-5 shadow-sm border border-emerald-800/60\">\n          <span className=\"text-[11px] font-bold text-emerald-300 uppercase tracking-wider block\">Impacto Ambiental</span>\n          <div className=\"text-3xl font-extrabold text-emerald-300 mt-1\">\n            {metrics.totalCo2eKgMonth.toFixed(0)} <span className=\"text-sm font-semibold text-emerald-200\">kg CO\342\202\202e</span>\n          </div>\n          <p className=\"text-xs text-emerald-200 mt-2\">\n            Equivalente a <strong className=\"text-white\">{(metrics.totalCo2eKgMonth / 120).toFixed(1)} \303\241rvores</strong> plantadas\n          </p>\n        </div>\n      </div>\n\n      {/* Example Calculation Module (User Explicit Requirement #3) */}\n      <div className=\"bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm space-y-4\">\n        <div className=\"flex items-center justify-between border-b border-slate-200 pb-3\">\n          <div className=\"flex items-center gap-2 text-slate-900 font-bold text-base\">\n            <Calculator className=\"w-5 h-5 text-emerald-600\" />\n            <span>Exemplo de An\303\241lise Econ\303\263mica & Calculadora de Perdas</span>\n          </div>\n          <span className=\"text-xs text-slate-500 bg-slate-100 px-2.5 py-1 rounded-lg font-medium\">\n            F\303\263rmula: Perda Mensal = Quantidade (kg) \303\227 Custo M\303\251dio (\342\202\254/kg)\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6 items-center\">\n          {/* Controls */}\n          <div className=\"space-y-3 bg-slate-50 p-4 rounded-xl border border-slate-200 text-xs\">\n            <div>\n              <label className=\"block font-semibold text-slate-700 mb-1\">Produto / Mat\303\251ria-Prima</label>\n              <input\n                type=\"text\"\n                value={calcFoodType}\n                onChange={(e) => setCalcFoodType(e.target.value)}\n                className=\"w-full px-3 py-2 rounded-lg border border-slate-300 font-medium\"\n              />\n            </div>\n            <div className=\"grid grid-cols-2 gap-3\">\n              <div>\n                <label className=\"block font-semibold text-slate-700 mb-1\">Volume Desperdi\303\247ado (kg)</label>\n                <input\n                  type=\"number\"\n                  value={calcKg}\n                  onChange={(e) => setCalcKg(Number(e.target.value))}\n                  className=\"w-full px-3 py-2 rounded-lg border border-slate-300 font-bold\"\n                />\n              </div>\n              <div>\n                <label className=\"block font-semibold text-slate-700 mb-1\">Custo M\303\251dio (\342\202\254/kg)</label>\n                <input\n                  type=\"number\"\n                  step=\"0.5\"\n                  value={calcCostPerKg}\n                  onChange={(e) => setCalcCostPerKg(Number(e.target.value))}\n                  className=\"w-full px-3 py-2 rounded-lg border border-slate-300 font-bold\"\n                />\n              </div>\n            </div>\n          </div>\n\n          {/* Formula Display */}\n          <div className=\"bg-slate-900 text-white p-5 rounded-xl border border-slate-800 space-y-2 text-xs\">\n            <span className=\"text-emerald-400 font-semibold uppercase text-[10px] tracking-wider block\">C\303\241lculo de Exemplo em Tempo Real</span>\n            <p className=\"text-sm font-medium text-slate-200\">\n              Res\303\255duos de <strong className=\"text-white\">{calcFoodType}</strong>: {calcKg} kg \303\227 {calcCostPerKg.toFixed(2)} \342\202\254/kg\n            </p>\n            <div className=\"text-2xl font-extrabold text-rose-400 pt-1\">\n              Perda Mensal: {calcKg} \303\227 {calcCostPerKg.toFixed(2)} = {customLossMonthly.toLocaleString(\'pt-PT\', { minimumFractionDigits: 2 })} \342\202\254\n            </div>\n            <div className=\"text-xs text-slate-400 border-t border-slate-800 pt-2 mt-1\">\n              Perda Anual Projetada: <strong className=\"text-white\">{customLossAnnual.toLocaleString(\'pt-PT\', { minimumFractionDigits: 2 })} \342\202\254 / ano</strong>\n            </div>\n          </div>\n\n          {/* Savings Outcome */}\n          <div className=\"bg-emerald-50 p-5 rounded-xl border border-emerald-200 text-emerald-950 space-y-2 text-xs\">\n            <span className=\"font-bold text-emerald-800 text-sm block\">Potencial de Poupan\303\247a Directa</span>\n            <p className=\"text-slate-700 leading-relaxed\">\n              Ao aplicar a rota\303\247\303\243o FEFO e ajuste de por\303\247\303\243o neste produto, reduziria a perda em 70%:\n            </p>\n            <div className=\"text-2xl font-bold text-emerald-700 pt-1\">\n              + {(customLossMonthly * 0.70).toLocaleString(\'pt-PT\', { minimumFractionDigits: 2 })} \342\202\254 / m\303\252s recuperados!\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Breakdown Charts: Cost by Category & Per Sector Loss */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* Cost by Category Chart */}\n        <div className=\"bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm\">\n          <h3 className=\"text-base font-bold text-slate-900 mb-1\">Custo do Desperd\303\255cio por Categoria de Alimentos</h3>\n          <p className=\"text-xs text-slate-500 mb-4\">Total acumulado (\342\202\254) por grupo de alimentos no m\303\252s atual</p>\n\n          <div className=\"h-64 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <BarChart data={categoryChartData} margin={{ top: 10, right: 10, left: 0, bottom: 20 }}>\n                <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#f1f5f9\" />\n                <XAxis dataKey=\"name\" stroke=\"#64748b\" fontSize={11} angle={-15} textAnchor=\"end\" />\n                <YAxis stroke=\"#64748b\" fontSize={11} tickFormatter={(v) => `${v}\342\202\254`} />\n                <Tooltip\n                  formatter={(val: any) => [`${val} \342\202\254`, \'Custo Perdido\']}\n                  contentStyle={{ backgroundColor: \'#0f172a\', borderRadius: \'10px\', color: \'#fff\', fontSize: \'12px\' }}\n                />\n                <Bar dataKey=\"cost\" radius={[8, 8, 0, 0]}>\n                  {categoryChartData.map((entry, index) => (\n                    <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />\n                  ))}\n                </Bar>\n              </BarChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n        {/* Sector Loss Analysis */}\n        <div className=\"bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex flex-col justify-between\">\n          <div>\n            <h3 className=\"text-base font-bold text-slate-900 mb-1\">An\303\241lise de Custo e Causa por Setor</h3>\n            <p className=\"text-xs text-slate-500 mb-4\">Diagn\303\263stico das origens de quebras de stocks e devolu\303\247\303\265es</p>\n\n            <div className=\"space-y-3 text-xs\">\n              {sectorLossBreakdown.map((sector, idx) => (\n                <div key={idx} className=\"p-3 bg-slate-50 rounded-xl border border-slate-200 space-y-1\">\n                  <div className=\"flex items-center justify-between font-bold text-slate-800\">\n                    <span>{sector.sector}</span>\n                    <span className=\"text-rose-600\">{sector.lossCost.toFixed(2)} \342\202\254</span>\n                  </div>\n                  <p className=\"text-[11px] text-slate-600\">\n                    <strong>Motivo Principal:</strong> {sector.mainReason}\n                  </p>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
