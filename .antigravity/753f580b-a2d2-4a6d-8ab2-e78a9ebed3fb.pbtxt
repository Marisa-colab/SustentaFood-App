  file_change {
    absolute_path_uri: "file:///src/components/ValorizationView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Recycle,\n  Plus,\n  Leaf,\n  Flame,\n  Droplet,\n  CheckCircle2,\n  Calendar,\n  Cloud\n} from \'lucide-react\';\nimport { ValorizationLog } from \'../types\';\n\ninterface ValorizationViewProps {\n  valorizationLogs: ValorizationLog[];\n  onAddValorizationLog: (log: Omit<ValorizationLog, \'id\'>) => void;\n}\n\nexport const ValorizationView: React.FC<ValorizationViewProps> = ({\n  valorizationLogs,\n  onAddValorizationLog\n}) => {\n  const [isModalOpen, setIsModalOpen] = useState(false);\n\n  const [destination, setDestination] = useState<\n    \'Compostagem\' | \'Alimenta\303\247\303\243o Animal\' | \'Biog\303\241s / Bioenergia\' | \'Reciclagem de \303\223leos (OAU)\' | \'Outro\'\n  >(\'Compostagem\');\n  const [quantityKg, setQuantityKg] = useState<number>(50);\n  const [partnerEntity, setPartnerEntity] = useState(\'Horta Comunit\303\241ria Urbana\');\n  const [responsible, setResponsible] = useState(\'Ant\303\263nio Costa (Sous-Chef)\');\n  const [notes, setNotes] = useState(\'Borras de caf\303\251 e cascas de fruta enviadas para compostagem org\303\242nica.\');\n\n  const totalKg = valorizationLogs.reduce((acc, curr) => acc + curr.quantityKg, 0);\n  const totalCo2Saved = valorizationLogs.reduce((acc, curr) => acc + curr.co2SavedKg, 0);\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (quantityKg <= 0) return;\n\n    // CO2 saved factor (e.g., 1.1 kg CO2 avoided per kg composted)\n    const co2Factor = destination === \'Reciclagem de \303\223leos (OAU)\' ? 3.0 : 1.1;\n\n    onAddValorizationLog({\n      destination,\n      quantityKg,\n      date: new Date().toISOString().split(\'T\')[0],\n      partnerEntity: partnerEntity.trim() || \'Entidade Parceira\',\n      co2SavedKg: Number((quantityKg * co2Factor).toFixed(1)),\n      responsible: responsible.trim(),\n      notes: notes.trim()\n    });\n\n    setIsModalOpen(false);\n  };\n\n  return (\n    <div className=\"space-y-6 pb-12\">\n      {/* Header Banner */}\n      <div className=\"bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <h2 className=\"text-xl font-bold text-slate-900\">Compostagem, Valoriza\303\247\303\243o & Economia Circular</h2>\n            <span className=\"text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 px-2.5 py-0.5 rounded-full border border-emerald-300\">\n              Desvio de Aterro Sanit\303\241rio\n            </span>\n          </div>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            Encaminhamento de res\303\255duos org\303\242nicos para compostagem, produ\303\247\303\243o de biog\303\241s, alimenta\303\247\303\243o animal e reciclagem de \303\263leos\n          </p>\n        </div>\n\n        <button\n          onClick={() => setIsModalOpen(true)}\n          className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold shadow-md transition-all\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Registar Envio para Valoriza\303\247\303\243o</span>\n        </button>\n      </div>\n\n      {/* Impact Stats */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        <div className=\"bg-emerald-950 text-white rounded-2xl p-4 border border-emerald-800 shadow-sm\">\n          <span className=\"text-[10px] font-bold uppercase tracking-wider text-emerald-400 block\">Total Desviado de Aterro</span>\n          <div className=\"text-3xl font-extrabold text-white mt-1\">{totalKg} kg</div>\n          <p className=\"text-xs text-emerald-300/80 mt-1\">100% transformado em recurso \303\272til</p>\n        </div>\n\n        <div className=\"bg-slate-900 text-white rounded-2xl p-4 border border-slate-800 shadow-sm\">\n          <span className=\"text-[10px] font-bold uppercase tracking-wider text-slate-400 block\">CO\342\202\202 Evitado</span>\n          <div className=\"text-3xl font-extrabold text-sky-400 mt-1\">{totalCo2Saved.toFixed(0)} kg CO\342\202\202</div>\n          <p className=\"text-xs text-slate-400 mt-1\">Cr\303\251ditos de carbono locais</p>\n        </div>\n\n        <div className=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-sm text-xs space-y-1\">\n          <div className=\"flex items-center gap-2 text-emerald-700 font-bold\">\n            <Leaf className=\"w-4 h-4\" /> <span>Fertilizante Org\303\242nico</span>\n          </div>\n          <p className=\"text-slate-600\">Proje\303\247\303\243o: ~{(totalKg * 0.45).toFixed(0)} kg de composto f\303\251rtil para hortas.</p>\n        </div>\n\n        <div className=\"bg-white p-4 rounded-2xl border border-slate-200 shadow-sm text-xs space-y-1\">\n          <div className=\"flex items-center gap-2 text-amber-700 font-bold\">\n            <Flame className=\"w-4 h-4\" /> <span>Bioenergia & OAU</span>\n          </div>\n          <p className=\"text-slate-600\">\303\223leos reciclados transformados em biodiesel limpo.</p>\n        </div>\n      </div>\n\n      {/* Logs Table */}\n      <div className=\"bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden\">\n        <div className=\"p-4 bg-slate-900 text-white font-bold text-sm flex items-center justify-between\">\n          <span>Registo Hist\303\263rico de Encaminhamentos Ecol\303\263gicos</span>\n        </div>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-slate-100 text-slate-700 font-semibold uppercase tracking-wider\">\n              <tr>\n                <th className=\"px-4 py-3\">Data</th>\n                <th className=\"px-4 py-3\">Destino Ecol\303\263gico</th>\n                <th className=\"px-4 py-3\">Entidade Recetora</th>\n                <th className=\"px-4 py-3 text-right\">Quantidade</th>\n                <th className=\"px-4 py-3 text-right\">CO\342\202\202 Evitado</th>\n                <th className=\"px-4 py-3\">Respons\303\241vel</th>\n                <th className=\"px-4 py-3\">Notas</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-200 text-slate-700\">\n              {valorizationLogs.map((log) => (\n                <tr key={log.id} className=\"hover:bg-slate-50\">\n                  <td className=\"px-4 py-3 font-semibold text-slate-900\">{log.date}</td>\n                  <td className=\"px-4 py-3\">\n                    <span className=\"font-bold text-emerald-800 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200\">\n                      {log.destination}\n                    </span>\n                  </td>\n                  <td className=\"px-4 py-3 font-medium text-slate-800\">{log.partnerEntity}</td>\n                  <td className=\"px-4 py-3 text-right font-bold text-slate-900\">{log.quantityKg} kg</td>\n                  <td className=\"px-4 py-3 text-right font-bold text-sky-700\">{log.co2SavedKg} kg CO\342\202\202</td>\n                  <td className=\"px-4 py-3 text-slate-600\">{log.responsible}</td>\n                  <td className=\"px-4 py-3 text-slate-500 italic max-w-xs\">{log.notes || \'-\'}</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* Modal */}\n      {isModalOpen && (\n        <div className=\"fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-4\">\n          <div className=\"bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 space-y-4\">\n            <div className=\"flex items-center justify-between border-b pb-3\">\n              <h3 className=\"font-bold text-slate-900 text-base\">Registar Valoriza\303\247\303\243o / Compostagem</h3>\n              <button onClick={() => setIsModalOpen(false)} className=\"text-slate-400 hover:text-slate-700\">\342\234\225</button>\n            </div>\n\n            <form onSubmit={handleSubmit} className=\"space-y-3 text-xs\">\n              <div>\n                <label className=\"block font-semibold text-slate-700 mb-1\">Destino Sustent\303\241vel *</label>\n                <select\n                  value={destination}\n                  onChange={(e: any) => setDestination(e.target.value)}\n                  className=\"w-full px-3 py-2 rounded-xl border font-medium\"\n                >\n                  <option value=\"Compostagem\">Compostagem Org\303\242nica</option>\n                  <option value=\"Alimenta\303\247\303\243o Animal\">Alimenta\303\247\303\243o Animal / Ra\303\247\303\243o</option>\n                  <option value=\"Biog\303\241s / Bioenergia\">Produ\303\247\303\243o de Biog\303\241s / Bioenergia</option>\n                  <option value=\"Reciclagem de \303\223leos (OAU)\">Reciclagem de \303\223leos Usados (OAU)</option>\n                  <option value=\"Outro\">Outro Processo de Reciclagem</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block font-semibold text-slate-700 mb-1\">Quantidade Enviada (kg / L) *</label>\n                <input\n                  type=\"number\"\n                  step=\"1\"\n                  min=\"1\"\n                  value={quantityKg}\n                  onChange={(e) => setQuantityKg(Number(e.target.value))}\n                  className=\"w-full px-3 py-2 rounded-xl border font-bold text-sm\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-semibold text-slate-700 mb-1\">Entidade / Parceiro Recetor *</label>\n                <input\n                  type=\"text\"\n                  value={partnerEntity}\n                  onChange={(e) => setPartnerEntity(e.target.value)}\n                  className=\"w-full px-3 py-2 rounded-xl border\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-semibold text-slate-700 mb-1\">Respons\303\241vel</label>\n                <input\n                  type=\"text\"\n                  value={responsible}\n                  onChange={(e) => setResponsible(e.target.value)}\n                  className=\"w-full px-3 py-2 rounded-xl border\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-semibold text-slate-700 mb-1\">Notas</label>\n                <textarea\n                  rows={2}\n                  value={notes}\n                  onChange={(e) => setNotes(e.target.value)}\n                  className=\"w-full px-3 py-2 rounded-xl border\"\n                />\n              </div>\n\n              <div className=\"flex justify-end gap-2 pt-3 border-t\">\n                <button\n                  type=\"button\"\n                  onClick={() => setIsModalOpen(false)}\n                  className=\"px-4 py-2 rounded-xl border font-semibold text-slate-700\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"px-4 py-2 rounded-xl bg-emerald-600 text-white font-semibold shadow\"\n                >\n                  Gravar Registo\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
