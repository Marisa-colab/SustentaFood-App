  file_change {
    absolute_path_uri: "file:///src/components/WasteLogModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { X, Plus, Calculator, Info, Sparkles } from \'lucide-react\';\nimport { WasteLog, WasteCategory, WasteType, ProductionLocation } from \'../types\';\nimport { CO2_FACTORS } from \'../mockData\';\n\ninterface WasteLogModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onAddWasteLog: (log: Omit<WasteLog, \'id\'>) => void;\n}\n\nconst CATEGORIES: WasteCategory[] = [\n  \'Carne\',\n  \'Peixe\',\n  \'Frutas\',\n  \'Legumes\',\n  \'Lactic\303\255nios\',\n  \'Padaria\',\n  \'Refei\303\247\303\265es Confecionadas\',\n  \'Outros\'\n];\n\nconst WASTE_TYPES: WasteType[] = [\n  \'Sobras de refei\303\247\303\265es\',\n  \'Produtos fora de prazo\',\n  \'Restos de prepara\303\247\303\243o\',\n  \'Alimentos devolvidos\',\n  \'Avaria / Falha de frio\',\n  \'Outro\'\n];\n\nconst LOCATIONS: ProductionLocation[] = [\n  \'Cozinha Central\',\n  \'Empratamento / Buffet\',\n  \'Armaz\303\251m / C\303\242mara Fria\',\n  \'Sala de Refei\303\247\303\265es\',\n  \'Bar / Cafetaria\',\n  \'Pastelaria\'\n];\n\nexport const WasteLogModal: React.FC<WasteLogModalProps> = ({\n  isOpen,\n  onClose,\n  onAddWasteLog\n}) => {\n  const now = new Date();\n  const defaultDate = now.toISOString().split(\'T\')[0];\n  const defaultTime = now.toTimeString().slice(0, 5);\n\n  const [item, setItem] = useState(\'\');\n  const [category, setCategory] = useState<WasteCategory>(\'Refei\303\247\303\265es Confecionadas\');\n  const [type, setType] = useState<WasteType>(\'Sobras de refei\303\247\303\265es\');\n  const [quantity, setQuantity] = useState<number>(5);\n  const [unit, setUnit] = useState<\'kg\' | \'L\'>(\'kg\');\n  const [costPerUnit, setCostPerUnit] = useState<number>(4.50);\n  const [location, setLocation] = useState<ProductionLocation>(\'Empratamento / Buffet\');\n  const [responsible, setResponsible] = useState(\'Jo\303\243o Silva (Chef)\');\n  const [notes, setNotes] = useState(\'\');\n  const [date, setDate] = useState(defaultDate);\n  const [time, setTime] = useState(defaultTime);\n\n  if (!isOpen) return null;\n\n  // Real-time calculations\n  const totalCost = Number((quantity * costPerUnit).toFixed(2));\n  const co2eFactor = CO2_FACTORS[category] || 2.0;\n  const co2eKg = Number((quantity * co2eFactor).toFixed(2));\n\n  // Quick preset helper\n  const handleApplyPreset = (\n    presetName: string,\n    presetCat: WasteCategory,\n    presetType: WasteType,\n    presetCost: number,\n    presetLoc: ProductionLocation\n  ) => {\n    setItem(presetName);\n    setCategory(presetCat);\n    setType(presetType);\n    setCostPerUnit(presetCost);\n    setLocation(presetLoc);\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!item.trim() || quantity <= 0) return;\n\n    onAddWasteLog({\n      item: item.trim(),\n      category,\n      type,\n      quantity,\n      unit,\n      costPerUnit,\n      totalCost,\n      date,\n      time,\n      location,\n      responsible: responsible.trim() || \'Operador de Servi\303\247o\',\n      notes: notes.trim(),\n      co2eKg\n    });\n\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto\">\n      <div className=\"bg-white rounded-2xl max-w-2xl w-full shadow-2xl border border-slate-200 overflow-hidden my-8 animate-in fade-in zoom-in-95 duration-200\">\n        {/* Header */}\n        <div className=\"bg-slate-900 text-white p-5 flex items-center justify-between border-b border-slate-800\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2 bg-emerald-500/20 rounded-lg border border-emerald-500/40 text-emerald-400\">\n              <Plus className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h2 className=\"text-lg font-bold text-white\">Registo de Res\303\255duo Alimentar</h2>\n              <p className=\"text-xs text-slate-400\">Introduza os dados para registo, controlo financeiro e pegada de CO\342\202\202</p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Quick Presets Bar */}\n        <div className=\"bg-slate-50 px-6 py-3 border-b border-slate-200 text-xs\">\n          <span className=\"font-semibold text-slate-600 block mb-1.5 flex items-center gap-1\">\n            <Sparkles className=\"w-3.5 h-3.5 text-amber-500\" /> Presets R\303\241pidos de Frequ\303\252ncia:\n          </span>\n          <div className=\"flex flex-wrap gap-2\">\n            <button\n              type=\"button\"\n              onClick={() => handleApplyPreset(\'Sobras de Sopa do Almo\303\247o\', \'Refei\303\247\303\265es Confecionadas\', \'Sobras de refei\303\247\303\265es\', 2.10, \'Empratamento / Buffet\')}\n              className=\"px-2.5 py-1 bg-white border border-slate-300 rounded-md text-slate-700 hover:border-emerald-500 hover:text-emerald-700 transition-colors\"\n            >\n              \360\237\215\262 Sobras de Sopa\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => handleApplyPreset(\'P\303\243o de Fatiar do Almo\303\247o\', \'Padaria\', \'Sobras de refei\303\247\303\265es\', 2.00, \'Bar / Cafetaria\')}\n              className=\"px-2.5 py-1 bg-white border border-slate-300 rounded-md text-slate-700 hover:border-emerald-500 hover:text-emerald-700 transition-colors\"\n            >\n              \360\237\245\226 P\303\243o Fatiado\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => handleApplyPreset(\'Aparas de Peixe / Salm\303\243o\', \'Peixe\', \'Restos de prepara\303\247\303\243o\', 12.50, \'Cozinha Central\')}\n              className=\"px-2.5 py-1 bg-white border border-slate-300 rounded-md text-slate-700 hover:border-emerald-500 hover:text-emerald-700 transition-colors\"\n            >\n              \360\237\220\237 Aparas de Peixe\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => handleApplyPreset(\'Cascas de Legumes e Batatas\', \'Legumes\', \'Restos de prepara\303\247\303\243o\', 1.20, \'Cozinha Central\')}\n              className=\"px-2.5 py-1 bg-white border border-slate-300 rounded-md text-slate-700 hover:border-emerald-500 hover:text-emerald-700 transition-colors\"\n            >\n              \360\237\245\225 Cascas de Legumes\n            </button>\n          </div>\n        </div>\n\n        {/* Form Body */}\n        <form onSubmit={handleSubmit} className=\"p-6 space-y-4 text-xs\">\n          {/* Item Name */}\n          <div>\n            <label className=\"block font-semibold text-slate-700 mb-1\">\n              Nome do Alimento / Produto Desperdi\303\247ado *\n            </label>\n            <input\n              type=\"text\"\n              required\n              placeholder=\"Ex: Sobras de Arroz de Pato, Lombo de Robalo, P\303\243o Fatiado...\"\n              value={item}\n              onChange={(e) => setItem(e.target.value)}\n              className=\"w-full px-3 py-2 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-sm font-medium\"\n            />\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            {/* Category */}\n            <div>\n              <label className=\"block font-semibold text-slate-700 mb-1\">\n                Categoria de Alimento *\n              </label>\n              <select\n                value={category}\n                onChange={(e) => setCategory(e.target.value as WasteCategory)}\n                className=\"w-full px-3 py-2 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-xs font-medium\"\n              >\n                {CATEGORIES.map((cat) => (\n                  <option key={cat} value={cat}>{cat}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Waste Type */}\n            <div>\n              <label className=\"block font-semibold text-slate-700 mb-1\">\n                Tipo / Origem do Desperd\303\255cio *\n              </label>\n              <select\n                value={type}\n                onChange={(e) => setType(e.target.value as WasteType)}\n                className=\"w-full px-3 py-2 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-xs font-medium\"\n              >\n                {WASTE_TYPES.map((t) => (\n                  <option key={t} value={t}>{t}</option>\n                ))}\n              </select>\n            </div>\n          </div>\n\n          {/* Quantities & Unit Costs */}\n          <div className=\"grid grid-cols-3 gap-3 bg-slate-50 p-3.5 rounded-xl border border-slate-200\">\n            <div>\n              <label className=\"block font-semibold text-slate-700 mb-1\">Quantidade *</label>\n              <input\n                type=\"number\"\n                step=\"0.1\"\n                min=\"0.1\"\n                required\n                value={quantity}\n                onChange={(e) => setQuantity(Number(e.target.value))}\n                className=\"w-full px-3 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-bold text-sm\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block font-semibold text-slate-700 mb-1\">Unidade</label>\n              <select\n                value={unit}\n                onChange={(e) => setUnit(e.target.value as \'kg\' | \'L\')}\n                className=\"w-full px-3 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium\"\n              >\n                <option value=\"kg\">Quilogramas (kg)</option>\n                <option value=\"L\">Litros (L)</option>\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block font-semibold text-slate-700 mb-1\">Custo M\303\251dio (\342\202\254/{unit})</label>\n              <input\n                type=\"number\"\n                step=\"0.05\"\n                min=\"0\"\n                required\n                value={costPerUnit}\n                onChange={(e) => setCostPerUnit(Number(e.target.value))}\n                className=\"w-full px-3 py-2 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-bold text-sm\"\n              />\n            </div>\n          </div>\n\n          {/* Real-time Calculation Summary Badge */}\n          <div className=\"bg-emerald-50 border border-emerald-200 rounded-xl p-3 flex items-center justify-between text-emerald-900\">\n            <div className=\"flex items-center gap-2\">\n              <Calculator className=\"w-4 h-4 text-emerald-600\" />\n              <span>Impacto Calculado Automaticamente:</span>\n            </div>\n            <div className=\"flex items-center gap-4 font-bold text-sm\">\n              <span>Custo Total: <strong className=\"text-rose-600\">{totalCost.toFixed(2)} \342\202\254</strong></span>\n              <span>Emiss\303\243o: <strong className=\"text-emerald-700\">{co2eKg} kg CO\342\202\202e</strong></span>\n            </div>\n          </div>\n\n          {/* Location & Responsible */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block font-semibold text-slate-700 mb-1\">Local de Produ\303\247\303\243o *</label>\n              <select\n                value={location}\n                onChange={(e) => setLocation(e.target.value as ProductionLocation)}\n                className=\"w-full px-3 py-2 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 text-xs font-medium\"\n              >\n                {LOCATIONS.map((loc) => (\n                  <option key={loc} value={loc}>{loc}</option>\n                ))}\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block font-semibold text-slate-700 mb-1\">Respons\303\241vel pelo Registo *</label>\n              <input\n                type=\"text\"\n                required\n                value={responsible}\n                onChange={(e) => setResponsible(e.target.value)}\n                className=\"w-full px-3 py-2 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-medium\"\n              />\n            </div>\n          </div>\n\n          {/* Date and Time */}\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block font-semibold text-slate-700 mb-1\">Data *</label>\n              <input\n                type=\"date\"\n                required\n                value={date}\n                onChange={(e) => setDate(e.target.value)}\n                className=\"w-full px-3 py-2 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block font-semibold text-slate-700 mb-1\">Hora *</label>\n              <input\n                type=\"time\"\n                required\n                value={time}\n                onChange={(e) => setTime(e.target.value)}\n                className=\"w-full px-3 py-2 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500\"\n              />\n            </div>\n          </div>\n\n          {/* Notes */}\n          <div>\n            <label className=\"block font-semibold text-slate-700 mb-1\">Observa\303\247\303\265es / Motivo do Desperd\303\255cio</label>\n            <textarea\n              rows={2}\n              placeholder=\"Descreva a raz\303\243o espec\303\255fica (ex: sobreprodu\303\247\303\243o no servi\303\247o de almo\303\247o, erro de confe\303\247\303\243o, prazo ultrapassado...)\"\n              value={notes}\n              onChange={(e) => setNotes(e.target.value)}\n              className=\"w-full px-3 py-2 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500\"\n            />\n          </div>\n\n          {/* Actions */}\n          <div className=\"flex items-center justify-end gap-3 pt-3 border-t border-slate-200\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-4 py-2 rounded-xl border border-slate-300 text-slate-700 font-semibold hover:bg-slate-100 transition-colors\"\n            >\n              Cancelar\n            </button>\n            <button\n              type=\"submit\"\n              className=\"px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold shadow-md transition-all flex items-center gap-1.5\"\n            >\n              <Plus className=\"w-4 h-4\" />\n              <span>Gravar Registo</span>\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
    }
