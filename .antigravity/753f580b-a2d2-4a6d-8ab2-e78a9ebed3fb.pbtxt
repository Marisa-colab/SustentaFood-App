  file_change {
    absolute_path_uri: "file:///src/components/ReportsView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  FileSpreadsheet,\n  Download,\n  Printer,\n  Calendar,\n  Building,\n  CheckCircle2,\n  PieChart as PieIcon,\n  BarChart3,\n  Scale\n} from \'lucide-react\';\nimport { WasteLog, SummaryMetrics } from \'../types\';\nimport { monthlyWasteTrend, topWastedProducts, sectorLossBreakdown } from \'../mockData\';\n\ninterface ReportsViewProps {\n  metrics: SummaryMetrics;\n  wasteLogs: WasteLog[];\n}\n\nexport const ReportsView: React.FC<ReportsViewProps> = ({\n  metrics,\n  wasteLogs\n}) => {\n  const [selectedMonth, setSelectedMonth] = useState(\'Julho 2026\');\n\n  // Export CSV\n  const handleExportExcel = () => {\n    const headers = [\'ID\', \'Data\', \'Hora\', \'Alimento\', \'Categoria\', \'Tipo\', \'Quantidade\', \'Unidade\', \'Custo Total (\342\202\254)\', \'CO2e (kg)\', \'Local\', \'Responsavel\'];\n    const rows = wasteLogs.map(l => [\n      l.id,\n      l.date,\n      l.time,\n      `\"${l.item.replace(/\"/g, \'\"\"\')}\"`,\n      l.category,\n      l.type,\n      l.quantity,\n      l.unit,\n      l.totalCost,\n      l.co2eKg,\n      `\"${l.location}\"`,\n      `\"${l.responsible.replace(/\"/g, \'\"\"\')}\"`\n    ]);\n\n    const csvContent = \'\\uFEFF\' + [headers.join(\';\'), ...rows.map(r => r.join(\';\'))].join(\'\\n\');\n    const blob = new Blob([csvContent], { type: \'text/csv;charset=utf-8;\' });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\'a\');\n    link.href = url;\n    link.setAttribute(\'download\', `SustentaFood_Relatorio_${selectedMonth.replace(\' \', \'_\')}.csv`);\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n  };\n\n  return (\n    <div className=\"space-y-6 pb-12\">\n      {/* Action Header */}\n      <div className=\"bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900\">Relat\303\263rios Autom\303\241ticos & Executivos</h2>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            Gera\303\247\303\243o de relat\303\263rios mensais de sustentabilidade, auditoria e exporta\303\247\303\243o de dados para Excel / PDF\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <select\n            value={selectedMonth}\n            onChange={(e) => setSelectedMonth(e.target.value)}\n            className=\"px-3 py-2 rounded-xl border border-slate-300 text-xs font-semibold text-slate-700 focus:outline-none\"\n          >\n            <option value=\"Julho 2026\">Julho 2026</option>\n            <option value=\"Junho 2026\">Junho 2026</option>\n            <option value=\"Maio 2026\">Maio 2026</option>\n          </select>\n\n          <button\n            onClick={handleExportExcel}\n            className=\"flex items-center gap-2 px-3.5 py-2.5 rounded-xl border border-slate-300 text-slate-800 hover:bg-slate-50 font-semibold text-xs transition-colors\"\n          >\n            <Download className=\"w-4 h-4 text-emerald-600\" />\n            <span>Exportar Excel (CSV)</span>\n          </button>\n\n          <button\n            onClick={() => window.print()}\n            className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs shadow-md transition-all\"\n          >\n            <Printer className=\"w-4 h-4\" />\n            <span>Imprimir PDF Executivo</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Printable Report Layout */}\n      <div className=\"bg-white rounded-2xl p-8 border border-slate-200 shadow-lg space-y-6 printable-area text-slate-900\">\n        {/* Header */}\n        <div className=\"flex justify-between items-start border-b pb-4\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-2xl font-extrabold text-slate-900 font-sans\">\n                Sustenta<span className=\"text-emerald-600\">Food</span>\n              </span>\n              <span className=\"text-xs font-bold bg-slate-100 text-slate-700 px-2 py-0.5 rounded border\">\n                Relat\303\263rio Executivo Mensal\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-500 mt-1\">Per\303\255odo de An\303\241lise: {selectedMonth} | Emissor: Sistema Autom\303\241tico SustentaFood</p>\n          </div>\n          <div className=\"text-right text-xs\">\n            <span className=\"font-bold block text-slate-800\">Estabelecimento: Cozinha Central SustentaFood</span>\n            <span className=\"text-slate-500\">NIF: 501234567</span>\n          </div>\n        </div>\n\n        {/* Executive Summary Cards */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs\">\n          <div className=\"p-4 bg-slate-50 rounded-xl border border-slate-200\">\n            <span className=\"text-slate-500 font-medium block uppercase text-[10px]\">Volume Total de Res\303\255duos</span>\n            <div className=\"text-xl font-extrabold text-slate-900 mt-0.5\">{metrics.totalWasteKgMonth} kg</div>\n            <span className=\"text-[10px] text-emerald-600 font-semibold\">-9.2% vs. m\303\252s anterior</span>\n          </div>\n\n          <div className=\"p-4 bg-slate-50 rounded-xl border border-slate-200\">\n            <span className=\"text-slate-500 font-medium block uppercase text-[10px]\">Perda Econ\303\263mica Total</span>\n            <div className=\"text-xl font-extrabold text-rose-600 mt-0.5\">{metrics.totalCostLostMonth.toFixed(2)} \342\202\254</div>\n            <span className=\"text-[10px] text-slate-500\">M\303\251dia: {(metrics.totalCostLostMonth / 30).toFixed(2)} \342\202\254/dia</span>\n          </div>\n\n          <div className=\"p-4 bg-slate-50 rounded-xl border border-slate-200\">\n            <span className=\"text-slate-500 font-medium block uppercase text-[10px]\">Emiss\303\265es CO\342\202\202e Geradas</span>\n            <div className=\"text-xl font-extrabold text-emerald-700 mt-0.5\">{metrics.totalCo2eKgMonth.toFixed(0)} kg CO\342\202\202e</div>\n            <span className=\"text-[10px] text-slate-500\">Fator de emiss\303\243o m\303\251dio</span>\n          </div>\n\n          <div className=\"p-4 bg-slate-50 rounded-xl border border-slate-200\">\n            <span className=\"text-slate-500 font-medium block uppercase text-[10px]\">Desperd\303\255cio / Refei\303\247\303\243o</span>\n            <div className=\"text-xl font-extrabold text-indigo-700 mt-0.5\">{(metrics.kgPerMeal * 1000).toFixed(0)} g</div>\n            <span className=\"text-[10px] text-slate-500\">{metrics.mealsServedMonth} refei\303\247\303\265es servidas</span>\n          </div>\n        </div>\n\n        {/* Top Products Table */}\n        <div className=\"space-y-2 text-xs\">\n          <h3 className=\"font-bold text-slate-900 text-sm\">Resumo dos Principais Alimentos Desperdi\303\247ados</h3>\n          <table className=\"w-full text-left border rounded-lg overflow-hidden\">\n            <thead className=\"bg-slate-100 text-slate-700 font-bold\">\n              <tr>\n                <th className=\"p-2.5\">Alimento</th>\n                <th className=\"p-2.5\">Categoria</th>\n                <th className=\"p-2.5 text-right\">Peso (kg)</th>\n                <th className=\"p-2.5 text-right\">Custo Perdido (\342\202\254)</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y text-slate-800\">\n              {topWastedProducts.slice(0, 5).map((p, idx) => (\n                <tr key={idx}>\n                  <td className=\"p-2.5 font-medium\">{p.name}</td>\n                  <td className=\"p-2.5\">{p.category}</td>\n                  <td className=\"p-2.5 text-right font-bold\">{p.kg} kg</td>\n                  <td className=\"p-2.5 text-right font-bold text-rose-600\">{p.cost.toFixed(2)} \342\202\254</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n\n        {/* Sector Loss Breakdown */}\n        <div className=\"space-y-2 text-xs\">\n          <h3 className=\"font-bold text-slate-900 text-sm\">Distribui\303\247\303\243o das Perdas por Setor</h3>\n          <div className=\"grid grid-cols-2 gap-3\">\n            {sectorLossBreakdown.map((s, idx) => (\n              <div key={idx} className=\"p-3 bg-slate-50 rounded-xl border flex justify-between items-center\">\n                <div>\n                  <span className=\"font-bold text-slate-900 block\">{s.sector}</span>\n                  <span className=\"text-[11px] text-slate-500\">{s.mainReason}</span>\n                </div>\n                <div className=\"text-right font-bold text-rose-600\">\n                  {s.lossCost.toFixed(2)} \342\202\254 ({s.percent}%)\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Conclusion / Audit Notes */}\n        <div className=\"p-4 bg-emerald-50 rounded-xl border border-emerald-200 text-emerald-950 text-xs space-y-1\">\n          <span className=\"font-bold text-emerald-900 block\">Conclus\303\243o e Parecer do Sistema SustentaFood</span>\n          <p className=\"leading-relaxed\">\n            Relat\303\263rio gerado em conformidade com as metas de economia circular e redu\303\247\303\243o de pegada ecol\303\263gica. A implementa\303\247\303\243o do plano FEFO e doa\303\247\303\265es permitiu desviar 100% dos excedentes seguros da via do aterro sanit\303\241rio.\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
